# Supabase — project-root `.env.local` only (do not nest copies in subfolders).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Server-only — never expose to the browser. Required for steward invites
# and privileged storage setup checks on /admin/dashboard (developer).
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Google Maps JS API key (Maps JavaScript API + Places API enabled).
# Powers location autocomplete + map preview in the admin forms and the
# "View on Map" buttons on public cards. Optional — forms degrade to plain
# address inputs when unset.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
